# option_archive credentials — deployed to /etc/option_archive/env (mode 0600,
# owner = the service user). NEVER committed with real values. Loaded by the
# systemd units via EnvironmentFile=.
#
# ClickHouse HOST/PORT are resolved via service discovery (the locator); only the
# PASSWORD comes from here. The connector reads CLICKHOUSE_PASSWORD and fails loud if
# it is unset — there is no in-source default (a committed default is a leaked
# credential). CLICKHOUSE_USER / CLICKHOUSE_DATABASE are optional (default/trading).
CLICKHOUSE_PASSWORD=
MASSIVE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Flat-file S3 (the account's own keys, from the dashboard — not the docs example).
MASSIVE_S3_ACCESS_KEY=
MASSIVE_S3_SECRET_KEY=
