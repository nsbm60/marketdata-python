# option_archive credentials — deployed to /etc/option_archive/env (mode 0600,
# owner = the service user). NEVER committed with real values. Loaded by the
# systemd units via EnvironmentFile=, read at runtime by option_archive.config,
# greeks, and ml.shared.
MASSIVE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Flat-file S3 (the account's own keys, from the dashboard — not the docs example).
MASSIVE_S3_ACCESS_KEY=
MASSIVE_S3_SECRET_KEY=
# ClickHouse resolves host via service discovery; set the password only if the
# server does not use the canonical default.
CLICKHOUSE_PASSWORD=
