[Unit]
Description=option_archive one-time queue seed (2016-01-04 forward, full watchlist)
# No ordering dependency on the discovery locator: the ClickHouse connector's
# retry-with-backoff is the mechanism that waits for it. Only the network is a
# genuine start-ordering prerequisite.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mdapps
Group=mdapps
WorkingDirectory=/opt/option_archive/app
EnvironmentFile=/etc/option_archive/env
# PYTHONUNBUFFERED=1 so per-name progress lands in journald live. NOTE: systemd
# Environment= takes no trailing comment — a '# ...' after the value is parsed as
# more VAR=VAL assignments and shows up as junk in the journal. Keep it value-only.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/option_archive/venv/bin/python -m option_archive.seed
# The seed enumerates a decade x the full watchlist — hours. No deadline.
TimeoutStartSec=infinity

# Run once, watch progress:  systemctl start option_archive-seed
#                            journalctl -u option_archive-seed -f
