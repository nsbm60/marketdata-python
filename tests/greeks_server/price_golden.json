{
  "_doc": "Golden cases for the greeks-server price rule (greeks-server-spec.md §4). Python-only. A price is usable iff its ts <= at_or_before_ms (T). No lower bound and no session. null = absent.",
  "at_or_before_ms": 5000,
  "cases": [
    {"name": "two-sided quote -> mid",                     "quote": {"bid": 1.0, "ask": 1.2, "ts": 2000}, "trade": {"price": 1.5, "ts": 3000}, "expect": {"kind": "mid",  "value": 1.1, "ts": 2000}},
    {"name": "quote at T counts",                          "quote": {"bid": 1.0, "ask": 1.2, "ts": 5000}, "trade": null,                        "expect": {"kind": "mid",  "value": 1.1, "ts": 5000}},
    {"name": "mid wins over a newer trade",                "quote": {"bid": 1.0, "ask": 1.2, "ts": 999},  "trade": {"price": 1.5, "ts": 3000}, "expect": {"kind": "mid",  "value": 1.1, "ts": 999}},
    {"name": "one-sided quote (no bid), trade -> last",    "quote": {"bid": null, "ask": 1.2, "ts": 2000}, "trade": {"price": 1.5, "ts": 3000}, "expect": {"kind": "last", "value": 1.5, "ts": 3000}},
    {"name": "zero bid is not two-sided",                  "quote": {"bid": 0.0, "ask": 0.05, "ts": 2000}, "trade": null,                       "expect": null},
    {"name": "crossed quote is not valid",                 "quote": {"bid": 1.3, "ask": 1.2, "ts": 2000}, "trade": {"price": 1.25, "ts": 2500}, "expect": {"kind": "last", "value": 1.25, "ts": 2500}},
    {"name": "locked quote is valid",                      "quote": {"bid": 1.2, "ask": 1.2, "ts": 2000}, "trade": null,                        "expect": {"kind": "mid",  "value": 1.2, "ts": 2000}},
    {"name": "no lower bound: an old trade is usable",     "quote": null,                                 "trade": {"price": 1.5, "ts": 500},  "expect": {"kind": "last", "value": 1.5, "ts": 500}},
    {"name": "quote after T rejected, trade -> last",      "quote": {"bid": 1.0, "ask": 1.2, "ts": 6000}, "trade": {"price": 1.5, "ts": 4000}, "expect": {"kind": "last", "value": 1.5, "ts": 4000}},
    {"name": "trade after T -> nothing",                   "quote": null,                                 "trade": {"price": 1.5, "ts": 6000}, "expect": null},
    {"name": "nothing at all",                             "quote": null,                                 "trade": null,                        "expect": null}
  ]
}
